{
  "comments": {
    "lineComment": "--",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "autoCloseBefore": ";:.,=}])>| \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:package\\b|--\\s*#?region\\b)",
      "end": "^\\s*(?:endpackage\\b|--\\s*#?endregion\\b)"
    }
  },
  "wordPattern": "(\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)|(_'(?:[^'\\\\]|\\\\.)*')|([^\\s`~!@#%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?]+)",
  "indentationRules": {
    "increaseIndentPattern": "^((?!--).)*(\\{[^}'\"]*|\\([^)'\"]*|\\[[^\\]'\"]*)$",
    "decreaseIndentPattern": "^((?!.*?/\\*).*\\*/)?\\s*[}\\])].*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^((?!--).)*[^:]:\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
