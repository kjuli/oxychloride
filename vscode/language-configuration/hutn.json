{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "wordPattern": "(-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)|([^\\s`~!@#$%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?]+)",
  "indentationRules": {
    "increaseIndentPattern": "^((?!//).)*(\\{[^}'\"]*|\\([^)'\"]*|\\[[^\\]'\"]*)$",
    "decreaseIndentPattern": "^((?!.*?/\\*).*\\*/)?\\s*[}\\])].*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^((?!//).)*[A-Za-z_]\\w*\\s*:\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
